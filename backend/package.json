{
    "name": "echoform-authoritative",
    "version": "0.0.1",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "bun build --target=bun --outdir=dist src/index.ts --production --bytecode",
        "dev": "NODE_ENV=development bun run --watch --no-clear-screen .",
        "dev:prepare": "bun run db:migrate && bun run dev:seed",
        "format": "prettier --write \"**/*.{ts,tsx}\"",
        "lint": "eslint src/**/*.ts --ignore-pattern src/**/*.test.ts",
        "deps": "ncu --target semver",
        "test": "bun test",
        "db:generate": "bunx drizzle-kit generate",
        "db:migrate": "bun run scripts/migrate.ts",
        "db:seed": "bun run scripts/seed.ts",
        "codegen:asyncapi": "bun run scripts/asyncapi.ts"
    },
    "dependencies": {
        "@hono/standard-validator": "^0.2.2",
        "@hono/zod-validator": "^0.8.0",
        "@neondatabase/serverless": "^1.1.0",
        "@node-rs/bcrypt": "^1.10.7",
        "@scalar/hono-api-reference": "^0.11.3",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.12.25",
        "hono-openapi": "^1.3.0",
        "nanoid": "^5.1.11",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "zod": "^4.4.3",
        "zod-openapi": "^6.0.0"
    },
    "devDependencies": {
        "@asyncapi/cli": "^6.0.2",
        "@asyncapi/optimizer": "^1.0.4",
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@tsconfig/bun": "^1.0.10",
        "@types/bun": "^1.3.14",
        "bonjour-service": "^1.4.1",
        "chalk": "^5.6.2",
        "chalk-template": "^1.1.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^10.5.0",
        "npm-check-updates": "^22.2.3",
        "prettier": "^3.8.4",
        "typed-emitter": "^2.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "zod-to-json-schema": "^3.25.2"
    },
    "packageManager": "bun@1.3.14"
}
