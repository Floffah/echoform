{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "client.hello.schema.json",
  "title": "ClientHello",
  "type": "object",
  "additionalProperties": false,
  "required": ["accessToken", "clientVersion", "device"],
  "properties": {
    "accessToken": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "clientVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "device": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
